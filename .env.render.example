# ==============================================================================
# Environment Configuration for Render Deployment (Production)
# ==============================================================================
# Paste these variables into the Render Dashboard under:
# Web Service > Environment > Environment Variables
# ==============================================================================

# Core Application Settings
APP_NAME="Trivant Apparel Sourcing"
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com

# Error Logging (Streams real-time logs to the Render dashboard)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# External MySQL Database Connection
# Note: Render does not provide a free managed MySQL service. Connect your
# existing external MySQL database (e.g. Hostinger, TiDB Serverless, Clever Cloud)
DB_CONNECTION=mysql
DB_HOST=your-mysql-hostname.com
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
# MYSQL_ATTR_SSL_CA=

# Session & Cache Settings
# Using 'database' uses MySQL tables created during migrations
# Alternatively, 'cookie' or 'file' can be used if preferred
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Queue & Mail
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Filesystem & Storage
FILESYSTEM_DISK=public

# Automated Container Startup Flags
# If true, runs `php artisan migrate --force` automatically on container launch
RUN_MIGRATIONS=true

