# Version control
.git
.github

# Environment & Credentials (NEVER bake these into the container!)
.env
.env.*
!.env.example

# Local development files & vendor
node_modules
npm-debug.log
yarn-error.log
/vendor

# Storage & Cache
/storage/*.key
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/public/storage
/public/hot

# Tests & Docs
/tests
/docs
phpunit.xml
.phpunit.result.cache

# IDE & System Files
.idea
.vscode
.DS_Store
Thumbs.db
Desktop.ini

# Docker & local configs
Dockerfile*
docker-compose*
.dockerignore

