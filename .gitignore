# Laravel & Composer
/vendor/
node_modules/
npm-debug.log
yarn-error.log

# Environment files
.env
.env.backup
.env.*
!.env.example
!.env.render.example

# Laravel storage & framework
/storage/*.key
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/public/storage
/public/hot
/public/build/

# Media & large archives (unapproved)
*.mp4
*.mov
*.avi
*.wmv
*.zip
*.tar.gz
*.rar

# Logs & databases
*.log
*.sqlite
*.sqlite3

# IDE & OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Testing & Tools
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
